# Copy to .env and fill in. Never commit the real file.

NODE_ENV=development
PORT=4000

# Required. No default is shipped on purpose -- a known secret would let anyone
# mint a session token for any account.
#   node -e "console.log(crypto.randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Omit in development to use the in-memory store. Required in production: the
# API refuses to boot in production without it.
# DATABASE_URL=postgres://vaultify:vaultify@localhost:5432/vaultify

# Exact origin of the web client. No wildcards.
CORS_ORIGIN=http://localhost:5173

# Session lifetime, seconds.
ACCESS_TOKEN_TTL_SECONDS=900

# Largest vault we will store, bytes.
MAX_VAULT_BYTES=5242880

# Enable only when running behind a proxy that sets X-Forwarded-*. Trusting
# these headers without a proxy lets any client spoof its IP past the rate limiter.
TRUST_PROXY=false

# true | false | auto  (auto = on in production)
REQUIRE_HTTPS=auto
